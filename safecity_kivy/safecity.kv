
#:kivy 2.3.0
#:import CameraView modules.camera_view.CameraView

<MainScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 10
        spacing: 10
        canvas.before:
            Color:
                rgba: (0.1, 0.12, 0.16, 1) # Dark Background
            Rectangle:
                pos: self.pos
                size: self.size

        # --- HEADER ---
        BoxLayout:
            size_hint_y: 0.1
            Label:
                text: "SafeCity Mobile"
                font_size: '24sp'
                bold: True
                color: (1, 1, 1, 1)
            
            Label:
                text: root.status_text
                color: (0, 1, 0, 1) if root.status_level == "SAFE" else (1, 0, 0, 1)
                bold: True
                canvas.before:
                    Color:
                        rgba: (0.2, 0.2, 0.2, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [5]

        # --- CAMERA FEED ---
        RelativeLayout:
            size_hint_y: 0.7
            
            CameraView:
                id: camera_view
                size_hint: (1, 1)
                allow_stretch: True
                
            # Threat Overlay Border
            Label:
                text: camera_view.message
                font_size: '30sp'
                bold: True
                color: (1, 0, 0, 1)
                outline_width: 2
                outline_color: (0, 0, 0, 1)
                pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                opacity: 1 if camera_view.threat_level == "DANGER" else 0

        # --- SENSOR STATS ---
        GridLayout:
            size_hint_y: 0.1
            cols: 2
            Label:
                text: "Audio: " + str(int(root.audio_level))
            Label:
                text: "Gyro: " + root.gyro_status

        # --- CONTROLS ---
        BoxLayout:
            size_hint_y: 0.1
            spacing: 20
            
            Button:
                text: "START MONITORING" if not app.is_monitoring else "STOP"
                background_color: (0.2, 0.8, 0.2, 1) if not app.is_monitoring else (0.8, 0.2, 0.2, 1)
                on_release: root.toggle_monitoring()
                
            Button:
                text: "Voice Cmd: ON" if root.voice_active else "Voice Cmd: OFF"
                background_color: (0.2, 0.4, 0.8, 1) if root.voice_active else (0.5, 0.5, 0.5, 1)
                on_release: root.toggle_voice()
                
            Button:
                text: "Simulate Gyro Impact"
                on_release: root.simulate_impact()
