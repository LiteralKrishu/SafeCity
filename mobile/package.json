{
  "name": "safecity-mobile",
  "version": "2.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "eas build --platform android --profile preview",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "check": "npm run check:threat-language && npm run check:behavior-baseline && tsc --noEmit && expo-doctor",
    "check:behavior-baseline": "node scripts/validate-behavior-baseline.cjs",
    "check:threat-language": "node scripts/validate-threat-language.cjs"
  },
  "dependencies": {
    "@siteed/sherpa-onnx.rn": "^1.3.1",
    "expo": "~57.0.8",
    "expo-asset": "~57.0.7",
    "expo-audio": "~57.0.3",
    "expo-battery": "~57.0.1",
    "expo-camera": "~57.0.1",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.0",
    "expo-dev-client": "~57.0.8",
    "expo-file-system": "~57.0.1",
    "expo-haptics": "~57.0.0",
    "expo-linking": "~57.0.4",
    "expo-location": "~57.0.6",
    "expo-notifications": "~57.0.7",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.0",
    "expo-sensors": "~57.0.0",
    "expo-sharing": "~57.0.7",
    "expo-sms": "~57.0.0",
    "expo-speech": "^57.0.1",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.1",
    "expo-task-manager": "~57.0.6",
    "expo-translate-text": "^0.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "expo-doctor": "^1.20.1",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-fast-tflite"
        ]
      }
    }
  }
}
