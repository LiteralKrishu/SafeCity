#:kivy 2.3.0
#:import CameraView safecity_kivy.modules.camera_view.CameraView

<MainScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: [15, 10]
        spacing: 12
        canvas.before:
            Color:
                rgba: (0.05, 0.07, 0.09, 1)
            Rectangle:
                pos: self.pos
                size: self.size

        # --- HEADER ---
        BoxLayout:
            size_hint_y: None
            height: '60dp'
            spacing: 12
            
            Label:
                text: "SafeCity AI"
                font_size: '24sp'
                bold: True
                color: (1, 1, 1, 1)
                halign: 'left'
                text_size: self.size
            
            Label:
                text: root.status_text.upper()
                font_size: '14sp'
                bold: True
                color: root.status_color
                halign: 'right'
                text_size: self.size
                size_hint_x: 0.4

        # --- STATUS DISPLAY ---
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: '100dp'
            padding: 15
            canvas.before:
                Color:
                    rgba: root.status_bg_color
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [15]
            
            Label:
                text: root.status_level
                font_size: '28sp'
                bold: True
                color: root.status_color
            
            Label:
                text: "Triggers: " + root.active_triggers
                font_size: '12sp'
                color: (0.7, 0.7, 0.7, 1)

        # --- METRICS ---
        GridLayout:
            cols: 2
            size_hint_y: None
            height: '160dp'
            spacing: 10
            
            BoxLayout:
                orientation: 'vertical'
                padding: 10
                canvas.before:
                    Color:
                        rgba: (0.12, 0.14, 0.18, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]
                Label:
                    text: "Visual Threat"
                    font_size: '11sp'
                    color: (0.6, 0.6, 0.6, 1)
                Label:
                    text: str(int(root.visual_threat_val)) + "%"
                    font_size: '20sp'
                    bold: True

            BoxLayout:
                orientation: 'vertical'
                padding: 10
                canvas.before:
                    Color:
                        rgba: (0.12, 0.14, 0.18, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]
                Label:
                    text: "Audio Analysis"
                    font_size: '11sp'
                    color: (0.6, 0.6, 0.6, 1)
                Label:
                    text: str(int(root.audio_analysis_val)) + "%"
                    font_size: '20sp'
                    bold: True

            BoxLayout:
                orientation: 'vertical'
                padding: 10
                canvas.before:
                    Color:
                        rgba: (0.12, 0.14, 0.18, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]
                Label:
                    text: "Motion"
                    font_size: '11sp'
                    color: (0.6, 0.6, 0.6, 1)
                Label:
                    text: str(int(root.motion_impact_val)) + "%"
                    font_size: '20sp'
                    bold: True

            BoxLayout:
                orientation: 'vertical'
                padding: 10
                canvas.before:
                    Color:
                        rgba: (0.12, 0.14, 0.18, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]
                Label:
                    text: "Context"
                    font_size: '11sp'
                    color: (0.6, 0.6, 0.6, 1)
                Label:
                    text: str(int(root.context_risk_val)) + "%"
                    font_size: '20sp'
                    bold: True

        # --- CAMERA FEED ---
        BoxLayout:
            size_hint_y: 1
            padding: 3
            canvas.before:
                Color:
                    rgba: (0, 0, 0, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [15]
            
            CameraView:
                id: camera_view

        # --- CONTROLS ---
        BoxLayout:
            size_hint_y: None
            height: '80dp'
            spacing: 12
            
            Button:
                text: "START" if not app.is_monitoring else "STOP"
                font_size: '16sp'
                bold: True
                on_release: 
                    print("[BUTTON] START clicked!")
                    root.toggle_monitoring()
                canvas.before:
                    Color:
                        rgba: (0.05, 0.8, 0.4, 1) if not app.is_monitoring else (0.8, 0.2, 0.2, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [15]
                background_normal: ''
                background_color: (0, 0, 0, 0)
                color: (1, 1, 1, 1)

            Button:
                text: "VOICE"
                font_size: '14sp'
                bold: True
                size_hint_x: 0.4
                on_release:
                    print("[BUTTON] VOICE clicked!")
                    root.toggle_voice()
                canvas.before:
                    Color:
                        rgba: (0.1, 0.4, 0.8, 1) if root.voice_active else (0.3, 0.3, 0.3, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [15]
                background_normal: ''
                background_color: (0, 0, 0, 0)
                color: (1, 1, 1, 1)

            Button:
                text: "SOS"
                font_size: '18sp'
                bold: True
                size_hint_x: 0.5
                on_release:
                    print("[BUTTON] SOS clicked!")
                    root.manual_sos()
                canvas.before:
                    Color:
                        rgba: (0.9, 0.1, 0.1, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [15]
                background_normal: ''
                background_color: (0, 0, 0, 0)
                color: (1, 1, 1, 1)

        # --- SOS COUNTDOWN PANEL ---
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: '200dp' if root.sos_manager.state == "COUNTDOWN" else 0
            opacity: 1 if root.sos_manager.state == "COUNTDOWN" else 0
            padding: 20
            spacing: 10
            canvas.before:
                Color:
                    rgba: (0.85, 0.1, 0.1, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [20]
            
            Label:
                text: "EMERGENCY ALERT"
                font_size: '20sp'
                bold: True
                color: (1, 1, 1, 1)
            
            Label:
                text: str(int(root.sos_manager.countdown_remaining)) if root.sos_manager else "3"
                font_size: '80sp'
                bold: True
                color: (1, 1, 1, 1)
            
            Label:
                text: "Broadcast initiates in..."
                font_size: '12sp'
                color: (1, 1, 1, 0.8)
            
            BoxLayout:
                size_hint_y: None
                height: '50dp'
                spacing: 10
                
                Button:
                    text: "CANCEL"
                    bold: True
                    on_release: root.cancel_sos()
                    background_color: (0.3, 0.3, 0.3, 1)
                
                Button:
                    text: "SEND NOW"
                    bold: True
                    on_release: root.send_sos_now()
                    background_color: (0.1, 0.7, 0.2, 1)

        # --- SOS BROADCAST PANEL ---
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: '150dp' if root.sos_manager.state == "BROADCAST" else 0
            opacity: 1 if root.sos_manager.state == "BROADCAST" else 0
            padding: 20
            spacing: 10
            canvas.before:
                Color:
                    rgba: (0.2, 0, 0, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [20]
                Color:
                    rgba: (1, 0.2, 0.2, 1)
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, 20)
                    width: 2
            
            Label:
                text: "EMERGENCY BROADCAST ACTIVE"
                font_size: '18sp'
                bold: True
                color: (1, 0.3, 0.3, 1)
            
            Label:
                text: "Location: " + root.broadcast_location
                font_size: '12sp'
                color: (1, 1, 1, 1)
            
            Label:
                text: "Threat: " + root.broadcast_threat
                font_size: '12sp'
                color: (1, 1, 1, 1)
            
            Button:
                text: "END EMERGENCY"
                size_hint_y: None
                height: '40dp'
                bold: True
                on_release: root.end_emergency()
                background_color: (0.1, 0.6, 0.2, 1)
