{
  "expo": {
    "name": "SafeCity",
    "slug": "safecity",
    "scheme": "safecity",
    "version": "3.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/safecity-app-icon.png",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/safecity-app-icon.png",
      "bundleIdentifier": "com.safecity.mobile",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "location"
        ]
      }
    },
    "android": {
      "package": "com.safecity.mobile",
      "versionCode": 3,
      "allowBackup": false,
      "icon": "./assets/safecity-app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/safecity-adaptive-icon.png",
        "monochromeImage": "./assets/safecity-monochrome-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "FOREGROUND_SERVICE_MICROPHONE",
        "FOREGROUND_SERVICE_SPECIAL_USE",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "SEND_SMS",
        "USE_FULL_SCREEN_INTENT"
      ]
    },
    "plugins": [
      "./plugins/with-safecity-theme-colors",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/safecity-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/safecity-logo.png",
            "backgroundColor": "#080B13"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SafeCity takes one front and one rear photo only after an SOS is activated."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "SafeCity listens for possible distress and records 15 seconds after an SOS.",
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": false
        }
      ],
      "@siteed/sherpa-onnx.rn",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SafeCity uses your location during monitoring and an active SOS.",
          "locationAlwaysAndWhenInUsePermission": "SafeCity can attach your latest location to an active SOS.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "SafeCity uses device motion to detect possible falls or struggle patterns."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "safety-status",
          "icon": "./assets/safecity-notification-icon.png",
          "color": "#16BFCB"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Use Face ID to protect SafeCity incident data."
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": true
        }
      ],
      "expo-sharing",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "332c6ed5-2573-42bf-afa0-e1a27c8e575a"
      }
    }
  }
}
