
#:kivy 2.3.0
#:import CameraView safecity_kivy.modules.camera_view.CameraView
#:import Animation kivy.animation.Animation

<IconLabel@Label>:
    font_name: 'MDI'
    font_size: '24sp'

<MetricCard@BoxLayout>:
    orientation: 'vertical'
    padding: [12, 10]
    spacing: 5
    title: ""
    value: "0%"
    delta: ""
    icon: ""
    canvas.before:
        Color:
            rgba: (0.12, 0.14, 0.18, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12]
        Color:
            rgba: (1, 1, 1, 0.05)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, 12)
            width: 1
    
    BoxLayout:
        size_hint_y: 0.3
        spacing: 8
        IconLabel:
            text: root.icon
            font_size: '14sp'
            size_hint_x: None
            width: self.height
            color: (0.1, 0.7, 0.9, 1)
        Label:
            text: root.title
            font_size: '12sp'
            color: (0.6, 0.6, 0.6, 1)
            halign: 'left'
            text_size: self.size

    Label:
        text: root.value
        font_size: '22sp'
        bold: True
        color: (1, 1, 1, 1)
        size_hint_y: 0.4
        halign: 'left'
        text_size: self.size

    Label:
        text: root.delta
        font_size: '11sp'
        color: (0.5, 0.5, 0.5, 1)
        size_hint_y: 0.3
        halign: 'left'
        text_size: self.size

<MainScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: [15, 10]
        spacing: 15
        canvas.before:
            Color:
                rgba: (0.05, 0.07, 0.09, 1) if not (root.sos_manager and root.sos_manager.is_sos_active) else (0.15, 0, 0, 1)
            Rectangle:
                pos: self.pos
                size: self.size

        # --- HEADER ---
        BoxLayout:
            size_hint_y: None
            height: '60dp'
            spacing: 12
            padding: [5, 0]
            
            BoxLayout:
                spacing: 10
                IconLabel:
                    text: root.icons.SHIELD
                    font_size: '28sp'
                    color: (0.1, 0.7, 0.9, 1)
                    size_hint_x: None
                    width: self.height
                Label:
                    text: "SafeCity AI"
                    font_size: '24sp'
                    bold: True
                    color: (1, 1, 1, 1)
                    halign: 'left'
                    text_size: self.size
            
            # Status Badge (Pill)
            BoxLayout:
                size_hint_x: 0.35
                size_hint_y: 0.7
                pos_hint: {'center_y': 0.5}
                padding: [12, 5]
                canvas.before:
                    Color:
                        rgba: root.status_bg_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [20]
                Label:
                    text: root.status_text.upper() if not (root.sos_manager and root.sos_manager.is_sos_active) else "SOS ACTIVE"
                    font_size: '11sp'
                    bold: True
                    color: (1, 1, 1, 1)

        # --- STATUS CARD ---
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: 0.18
            padding: 20
            spacing: 8
            opacity: root.pulse_opacity
            canvas.before:
                Color:
                    rgba: root.status_bg_color
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [18]
                Color:
                    rgba: root.status_color
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, 18)
                    width: 1.5
            
            BoxLayout:
                size_hint_y: 0.3
                spacing: 10
                IconLabel:
                    text: root.icons.ALERT if root.status_level != "SAFE" else root.icons.CHECK
                    font_size: '18sp'
                    color: root.status_color
                    size_hint_x: None
                    width: self.height
                Label:
                    text: root.status_level
                    font_size: '18sp'
                    bold: True
                    color: root.status_color
                    halign: 'left'
                    text_size: self.size

            Label:
                text: root.status_text
                font_size: '20sp'
                color: (1, 1, 1, 1)
                bold: True
                size_hint_y: 0.4
                halign: 'left'
                text_size: self.size

            BoxLayout:
                size_hint_y: 0.3
                spacing: 5
                IconLabel:
                    text: root.icons.CHART
                    font_size: '12sp'
                    color: (0.6, 0.6, 0.6, 1)
                    size_hint_x: None
                    width: self.height
                Label:
                    text: "Triggers: " + root.active_triggers
                    font_size: '12sp'
                    color: (0.7, 0.7, 0.7, 1)
                    halign: 'left'
                    text_size: self.size

        # --- SOS OVERLAYS ---
        # Countdown
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: 0.45 if (root.sos_manager and root.sos_manager.state == "COUNTDOWN") else 0.001
            opacity: 1 if (root.sos_manager and root.sos_manager.state == "COUNTDOWN") else 0
            padding: 25
            spacing: 20
            canvas.before:
                Color:
                    rgba: (0.85, 0.1, 0.1, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [25]
                Color:
                    rgba: (1, 1, 1, 0.2)
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, 25)
                    width: 2
            
            Label:
                text: str(int(root.sos_manager.countdown_remaining)) if root.sos_manager else "3"
                font_size: '100sp'
                bold: True
                
            BoxLayout:
                size_hint_y: None
                height: '40dp'
                spacing: 10
                IconLabel:
                    text: root.icons.ALERT
                    size_hint_x: None
                    width: self.height
                Label:
                    text: "EMERGENCY BROADCAST IN SECONDS"
                    font_size: '16sp'
                    bold: True
                    halign: 'center'

            BoxLayout:
                size_hint_y: 0.3
                spacing: 20
                Button:
                    text: "CANCEL"
                    background_normal: ''
                    background_color: (0.15, 0.15, 0.15, 0.6)
                    bold: True
                    on_release: root.cancel_sos()
                Button:
                    text: "SEND NOW"
                    background_normal: ''
                    background_color: (1, 1, 1, 0.2)
                    bold: True
                    on_release: root.send_sos_now()

        # Broadcast Panel
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: 0.65 if (root.sos_manager and root.sos_manager.state == "BROADCAST") else 0.001
            opacity: 1 if (root.sos_manager and root.sos_manager.state == "BROADCAST") else 0
            padding: 20
            spacing: 15
            canvas.before:
                Color:
                    rgba: (0.08, 0.1, 0.15, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [20]
                Color:
                    rgba: (1, 0.2, 0.2, 0.8)
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, 20)
                    width: 2
            
            BoxLayout:
                size_hint_y: 0.15
                spacing: 10
                IconLabel:
                    text: root.icons.PULSE
                    color: (1, 0.2, 0.2, 1)
                Label:
                    text: "BROADCAST ACTIVE"
                    color: (1, 0.3, 0.3, 1)
                    font_size: '20sp'
                    bold: True
                    halign: 'left'
                    text_size: self.size

            GridLayout:
                cols: 2
                spacing: 15
                size_hint_y: 0.5
                
                # Rows
                IconLabel: 
                    text: root.icons.LOCATION
                    font_size: '16sp'
                    size_hint_x: 0.2
                    color: (0.6, 0.6, 0.6, 1)
                Label: 
                    text: root.broadcast_location
                    bold: True
                    halign: 'left'
                    text_size: self.size
                    
                IconLabel: 
                    text: root.icons.ALERT
                    font_size: '16sp'
                    size_hint_x: 0.2
                    color: (0.6, 0.6, 0.6, 1)
                Label: 
                    text: root.broadcast_threat
                    bold: True
                    halign: 'left'
                    text_size: self.size
                    
            Button:
                text: "END EMERGENCY"
                size_hint_y: 0.2
                background_normal: ''
                background_color: (0.1, 0.6, 0.2, 1)
                bold: True
                radius: [10]
                on_release: root.end_emergency()

        # --- METRICS GRID ---
        GridLayout:
            cols: 2
            size_hint_y: 0.25
            spacing: 12
            
            MetricCard:
                title: "Visual Threat"
                icon: root.icons.CAMERA
                value: str(int(root.visual_threat_val)) + "%"
                delta: "Action: " + (root.ids.camera_view.detected_action if root.ids.camera_view.detected_action else "None")
            MetricCard:
                title: "Audio Analysis"
                icon: root.icons.MIC
                value: str(int(root.audio_analysis_val)) + "%"
                delta: root.audio_analysis_msg
            MetricCard:
                title: "Motion Impact"
                icon: root.icons.PULSE
                value: str(int(root.motion_impact_val)) + "%"
                delta: "Gyro: " + root.gyro_status
            MetricCard:
                title: "Context Risk"
                icon: root.icons.LOCATION
                value: str(int(root.context_risk_val)) + "%"
                delta: "Location Risk"

        # System Confidence
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: '45dp'
            spacing: 8
            padding: [5, 5]
            
            BoxLayout:
                spacing: 8
                Label:
                    text: "System Confidence"
                    font_size: '12sp'
                    color: (0.6, 0.6, 0.6, 1)
                    halign: 'left'
                    text_size: self.size
                Label:
                    text: str(int(root.system_confidence * 100)) + "%"
                    font_size: '12sp'
                    bold: True
                    halign: 'right'
                    text_size: self.size
            
            Widget:
                size_hint_y: None
                height: '6dp'
                canvas:
                    Color:
                        rgba: (1, 1, 1, 0.1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [3]
                    Color:
                        rgba: (0.1, 0.7, 0.9, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: (self.width * root.system_confidence, self.height)
                        radius: [3]

        # --- CAMERA FEED ---
        BoxLayout:
            size_hint_y: 0.45
            canvas.before:
                Color:
                    rgba: (0, 0, 0, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [20]
                Color:
                    rgba: (1, 1, 1, 0.1)
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, 20)
                    width: 1.2
            padding: 3
            
            CameraView:
                id: camera_view
                allow_stretch: True
        
        # --- CONTROLS ---
        BoxLayout:
            size_hint_y: None
            height: '70dp'
            spacing: 12
            padding: [0, 5]
            
            Button:
                background_normal: ''
                background_color: (0.05, 0.8, 0.4, 0.15) if not app.is_monitoring else (0.8, 0.2, 0.2, 0.15)
                on_release: root.toggle_monitoring()
                canvas.before:
                    Color:
                        rgba: (0.05, 0.8, 0.4, 0.1) if not app.is_monitoring else (0.8, 0.2, 0.2, 0.1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [15]
                BoxLayout:
                    orientation: 'vertical'
                    pos: self.parent.pos
                    size: self.parent.size
                    padding: [0, 8]
                    IconLabel:
                        text: root.icons.START if not app.is_monitoring else root.icons.STOP
                        color: (0.05, 0.8, 0.4, 1) if not app.is_monitoring else (1, 0.3, 0.3, 1)
                    Label:
                        text: "START" if not app.is_monitoring else "STOP"
                        font_size: '10sp'
                        bold: True
                        color: (0.05, 0.8, 0.4, 1) if not app.is_monitoring else (1, 0.3, 0.3, 1)
                
            Button:
                size_hint_x: 0.3
                background_normal: ''
                background_color: (0.1, 0.4, 0.8, 0.15) if root.voice_active else (0.2, 0.2, 0.2, 0.15)
                on_release: root.toggle_voice()
                canvas.before:
                    Color:
                        rgba: (1, 1, 1, 0.05)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [15]
                BoxLayout:
                    orientation: 'vertical'
                    pos: self.parent.pos
                    size: self.parent.size
                    padding: [0, 8]
                    IconLabel:
                        text: root.icons.MIC if root.voice_active else root.icons.MIC_OFF
                        color: (0.1, 0.6, 1, 1) if root.voice_active else (0.6, 0.6, 0.6, 1)
                    Label:
                        text: "VOICE"
                        font_size: '10sp'
                        bold: True
                        color: (0.1, 0.6, 1, 1) if root.voice_active else (0.6, 0.6, 0.6, 1)
                
            Button:
                size_hint_x: 0.5
                background_normal: ''
                background_color: (0.9, 0.1, 0.1, 1)
                on_release: root.manual_sos()
                canvas.before:
                    Color:
                        rgba: (0.9, 0.1, 0.1, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [15]
                BoxLayout:
                    orientation: 'vertical'
                    pos: self.parent.pos
                    size: self.parent.size
                    padding: [0, 8]
                    IconLabel:
                        text: root.icons.SOS
                        color: (1, 1, 1, 1)
                    Label:
                        text: "MANUAL SOS"
                        font_size: '10sp'
                        bold: True
                        color: (1, 1, 1, 1)
