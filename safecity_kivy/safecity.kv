
#:kivy 2.3.0
#:import CameraView safecity_kivy.modules.camera_view.CameraView
#:import Animation kivy.animation.Animation

<IconLabel@Label>:
    font_name: 'MDI'
    font_size: '24sp'

<MetricCard@BoxLayout>:
    orientation: 'vertical'
    padding: [12, 10]
    spacing: 5
    title: ""
    value: "0%"
    delta: ""
    icon: ""
    canvas.before:
        Color:
            rgba: (0.12, 0.14, 0.18, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12]
        Color:
            rgba: (1, 1, 1, 0.05)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, 12)
            width: 1
    
    BoxLayout:
        size_hint_y: 0.3
        spacing: 8
        IconLabel:
            text: root.icon
            font_size: '14sp'
            size_hint_x: None
            width: self.height
            color: (0.1, 0.7, 0.9, 1)
        Label:
            text: root.title
            font_size: '12sp'
            color: (0.6, 0.6, 0.6, 1)
            halign: 'left'
            text_size: self.size

    Label:
        text: root.value
        font_size: '22sp'
        bold: True
        color: (1, 1, 1, 1)
        size_hint_y: 0.4
        halign: 'left'
        text_size: self.size

    Label:
        text: root.delta
        font_size: '11sp'
        color: (0.5, 0.5, 0.5, 1)
        size_hint_y: 0.3
        halign: 'left'
        text_size: self.size

<MainScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: [15, 10]
        spacing: 12
        canvas.before:
            Color:
                rgba: (0.05, 0.07, 0.09, 1) if not (root.sos_manager and root.sos_manager.is_sos_active) else (0.15, 0, 0, 1)
            Rectangle:
                pos: self.pos
                size: self.size

        # --- HEADER ---
        BoxLayout:
            size_hint_y: None
            height: '60dp'
            spacing: 12
            padding: [5, 0]
            
            BoxLayout:
                spacing: 10
                IconLabel:
                    text: root.icons.SHIELD
                    font_size: '28sp'
                    color: (0.1, 0.7, 0.9, 1)
                    size_hint_x: None
                    width: self.height
                Label:
                    text: "SafeCity AI"
                    font_size: '24sp'
                    bold: True
                    color: (1, 1, 1, 1)
                    halign: 'left'
                    text_size: self.size
            
            # Status Badge (Pill)
            BoxLayout:
                size_hint_x: 0.35
                size_hint_y: 0.7
                pos_hint: {'center_y': 0.5}
                padding: [12, 5]
                canvas.before:
                    Color:
                        rgba: root.status_bg_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [20]
                Label:
                    text: root.status_text.upper() if not (root.sos_manager and root.sos_manager.is_sos_active) else "SOS ACTIVE"
                    font_size: '11sp'
                    bold: True
                    color: (1, 1, 1, 1)

        # --- SCROLLABLE CONTENT ---
        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: 12
                padding: [0, 5]

                # --- STATUS CARD ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: '130dp'
                    padding: 20
                    spacing: 8
                    opacity: root.pulse_opacity
                    canvas.before:
                        Color:
                            rgba: root.status_bg_color
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [18]
                        Color:
                            rgba: root.status_color
                        Line:
                            rounded_rectangle: (self.x, self.y, self.width, self.height, 18)
                            width: 1.5
                    
                    BoxLayout:
                        size_hint_y: 0.35
                        spacing: 10
                        IconLabel:
                            text: root.icons.ALERT if root.status_level != "SAFE" else root.icons.CHECK
                            font_size: '18sp'
                            color: root.status_color
                            size_hint_x: None
                            width: self.height
                        Label:
                            text: root.status_level
                            font_size: '18sp'
                            bold: True
                            color: root.status_color
                            halign: 'left'
                            text_size: self.size

                    Label:
                        text: root.status_text
                        font_size: '20sp'
                        color: (1, 1, 1, 1)
                        bold: True
                        size_hint_y: 0.4
                        halign: 'left'
                        text_size: self.size

                    BoxLayout:
                        size_hint_y: 0.25
                        spacing: 5
                        IconLabel:
                            text: root.icons.CHART
                            font_size: '12sp'
                            color: (0.6, 0.6, 0.6, 1)
                            size_hint_x: None
                            width: self.height
                        Label:
                            text: "Triggers: " + root.active_triggers
                            font_size: '12sp'
                            color: (0.7, 0.7, 0.7, 1)
                            halign: 'left'
                            text_size: self.size

                # --- SOS CONTAINER ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: 0 if root.sos_manager.state == "IDLE" else (dp(320) if root.sos_manager.state == "COUNTDOWN" else dp(450))
                    padding: 0
                    spacing: 0
                    
                    # COUNTDOWN PANEL
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: 1 if (root.sos_manager and root.sos_manager.state == "COUNTDOWN") else 0
                        opacity: 1 if (root.sos_manager and root.sos_manager.state == "COUNTDOWN") else 0
                        padding: 25
                        spacing: 15
                        canvas.before:
                            Color:
                                rgba: (0.85, 0.1, 0.1, 1)
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [25]
                            Color:
                                rgba: (1, 1, 1, 0.3)
                            Line:
                                rounded_rectangle: (self.x, self.y, self.width, self.height, 25)
                                width: 2.5
                        
                        BoxLayout:
                            size_hint_y: 0.25
                            spacing: 12
                            padding: [10, 0]
                            IconLabel:
                                text: root.icons.ALERT
                                font_size: '28sp'
                                color: (1, 1, 1, 1)
                                size_hint_x: None
                                width: self.height
                            Label:
                                text: "EMERGENCY ALERT"
                                font_size: '22sp'
                                bold: True
                                color: (1, 1, 1, 1)
                                halign: 'left'
                                text_size: self.size
                        
                        Label:
                            text: str(int(root.sos_manager.countdown_remaining)) if root.sos_manager else "3"
                            font_size: '120sp'
                            bold: True
                            color: (1, 1, 1, 1)
                            size_hint_y: 0.35
                        
                        Label:
                            text: "Broadcast initiates in"
                            font_size: '14sp'
                            color: (1, 1, 1, 0.8)
                            halign: 'center'
                            text_size: self.size
                            size_hint_y: 0.15

                        BoxLayout:
                            size_hint_y: 0.25
                            spacing: 15
                            padding: [10, 0]
                            Button:
                                text: "CANCEL"
                                background_normal: ''
                                background_color: (0.2, 0.2, 0.2, 0.9)
                                bold: True
                                font_size: '14sp'
                                on_release: root.cancel_sos()
                                canvas.before:
                                    Color:
                                        rgba: self.background_color
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [12]
                            Button:
                                text: "SEND NOW"
                                background_normal: ''
                                background_color: (0.1, 0.7, 0.2, 1)
                                bold: True
                                font_size: '14sp'
                                on_release: root.send_sos_now()
                                canvas.before:
                                    Color:
                                        rgba: self.background_color
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [12]

                    # BROADCAST PANEL
                    ScrollView:
                        size_hint_y: 1 if (root.sos_manager and root.sos_manager.state == "BROADCAST") else 0
                        opacity: 1 if (root.sos_manager and root.sos_manager.state == "BROADCAST") else 0
                        do_scroll_x: False
                        do_scroll_y: True
                        
                        BoxLayout:
                            orientation: 'vertical'
                            size_hint_y: None
                            height: self.minimum_height
                            padding: 20
                            spacing: 15
                            canvas.before:
                                Color:
                                    rgba: (0.08, 0.1, 0.15, 1)
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [20]
                                Color:
                                    rgba: (1, 0.2, 0.2, 0.9)
                                Line:
                                    rounded_rectangle: (self.x, self.y, self.width, self.height, 20)
                                    width: 2.5
                            
                            # HEADER
                            BoxLayout:
                                size_hint_y: None
                                height: '50dp'
                                spacing: 12
                                padding: [0, 5]
                                IconLabel:
                                    text: root.icons.PULSE
                                    color: (1, 0.2, 0.2, 1)
                                    font_size: '24sp'
                                    size_hint_x: None
                                    width: self.height
                                Label:
                                    text: "EMERGENCY BROADCAST ACTIVE"
                                    color: (1, 0.3, 0.3, 1)
                                    font_size: '18sp'
                                    bold: True
                                    halign: 'left'
                                    text_size: self.size

                            # ALERT STATUS
                            BoxLayout:
                                orientation: 'vertical'
                                size_hint_y: None
                                height: '65dp'
                                padding: [12, 10]
                                spacing: 5
                                canvas.before:
                                    Color:
                                        rgba: (0.2, 0, 0, 0.8)
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [10]
                                Label:
                                    text: "Status: BROADCASTING TO EMERGENCY SERVICES"
                                    font_size: '12sp'
                                    bold: True
                                    color: (1, 0.2, 0.2, 1)
                                    halign: 'center'
                                    text_size: self.size
                                Label:
                                    text: root.broadcast_contact
                                    font_size: '11sp'
                                    color: (0.8, 0.8, 0.8, 1)
                                    halign: 'center'
                                    text_size: self.size
                                Label:
                                    text: "Time: " + root.broadcast_timestamp
                                    font_size: '10sp'
                                    color: (0.7, 0.7, 0.7, 1)
                                    halign: 'center'
                                    text_size: self.size

                            # LOCATION
                            BoxLayout:
                                orientation: 'vertical'
                                size_hint_y: None
                                height: '70dp'
                                padding: [12, 10]
                                spacing: 8
                                canvas.before:
                                    Color:
                                        rgba: (0.12, 0.14, 0.18, 1)
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [10]
                                BoxLayout:
                                    size_hint_y: 0.3
                                    spacing: 10
                                    IconLabel:
                                        text: root.icons.LOCATION
                                        font_size: '14sp'
                                        color: (0.1, 0.7, 0.9, 1)
                                        size_hint_x: None
                                        width: self.height
                                    Label:
                                        text: "LOCATION"
                                        font_size: '11sp'
                                        color: (0.6, 0.6, 0.6, 1)
                                        halign: 'left'
                                        text_size: self.size
                                Label:
                                    text: root.broadcast_location
                                    font_size: '16sp'
                                    bold: True
                                    color: (1, 1, 1, 1)
                                    halign: 'left'
                                    text_size: self.size

                            # THREAT INFO
                            BoxLayout:
                                orientation: 'vertical'
                                size_hint_y: None
                                height: '85dp'
                                padding: [12, 10]
                                spacing: 8
                                canvas.before:
                                    Color:
                                        rgba: (0.12, 0.14, 0.18, 1)
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [10]
                                BoxLayout:
                                    size_hint_y: 0.25
                                    spacing: 10
                                    IconLabel:
                                        text: root.icons.ALERT
                                        font_size: '14sp'
                                        color: (1, 0.3, 0.3, 1)
                                        size_hint_x: None
                                        width: self.height
                                    Label:
                                        text: "THREAT"
                                        font_size: '11sp'
                                        color: (0.6, 0.6, 0.6, 1)
                                        halign: 'left'
                                        text_size: self.size
                                Label:
                                    text: root.broadcast_threat
                                    font_size: '14sp'
                                    bold: True
                                    color: (1, 1, 1, 1)
                                    halign: 'left'
                                    text_size: self.size

                            # ACTIVE TRIGGERS
                            BoxLayout:
                                orientation: 'vertical'
                                size_hint_y: None
                                height: '80dp'
                                padding: [12, 10]
                                spacing: 8
                                canvas.before:
                                    Color:
                                        rgba: (0.12, 0.14, 0.18, 1)
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [10]
                                BoxLayout:
                                    size_hint_y: 0.25
                                    spacing: 10
                                    IconLabel:
                                        text: root.icons.CHART
                                        font_size: '14sp'
                                        color: (0.1, 0.7, 0.9, 1)
                                        size_hint_x: None
                                        width: self.height
                                    Label:
                                        text: "DETECTED TRIGGERS"
                                        font_size: '11sp'
                                        color: (0.6, 0.6, 0.6, 1)
                                        halign: 'left'
                                        text_size: self.size
                                Label:
                                    text: root.active_triggers
                                    font_size: '13sp'
                                    bold: True
                                    color: (1, 1, 1, 1)
                                    halign: 'left'
                                    text_size: self.size

                            # CONFIDENCE
                            BoxLayout:
                                orientation: 'vertical'
                                size_hint_y: None
                                height: '55dp'
                                padding: [12, 10]
                                spacing: 6
                                canvas.before:
                                    Color:
                                        rgba: (0.12, 0.14, 0.18, 1)
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [10]
                                BoxLayout:
                                    spacing: 8
                                    Label:
                                        text: "System Confidence"
                                        font_size: '11sp'
                                        color: (0.6, 0.6, 0.6, 1)
                                        halign: 'left'
                                        text_size: self.size
                                    Label:
                                        text: str(int(root.system_confidence * 100)) + "%"
                                        font_size: '12sp'
                                        bold: True
                                        color: (0.1, 0.7, 0.9, 1)
                                        halign: 'right'
                                        text_size: self.size
                                Widget:
                                    size_hint_y: None
                                    height: '8dp'
                                    canvas:
                                        Color:
                                            rgba: (1, 1, 1, 0.15)
                                        RoundedRectangle:
                                            pos: self.pos
                                            size: self.size
                                            radius: [4]
                                        Color:
                                            rgba: (0.1, 0.7, 0.9, 1)
                                        RoundedRectangle:
                                            pos: self.pos
                                            size: (self.width * root.system_confidence, self.height)
                                            radius: [4]

                            # END BUTTON
                            Button:
                                text: "END EMERGENCY"
                                size_hint_y: None
                                height: '50dp'
                                background_normal: ''
                                background_color: (0.1, 0.6, 0.2, 1)
                                bold: True
                                font_size: '16sp'
                                on_release: root.end_emergency()
                                canvas.before:
                                    Color:
                                        rgba: self.background_color
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [12]

                # --- METRICS GRID (shown only in normal mode) ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(280) if root.sos_manager.state == "IDLE" else 0
                    opacity: 1 if root.sos_manager.state == "IDLE" else 0
                    spacing: 12
                    
                    GridLayout:
                        cols: 2
                        size_hint_y: 0.7
                        spacing: 12
                        
                        MetricCard:
                            title: "Visual Threat"
                            icon: root.icons.CAMERA
                            value: str(int(root.visual_threat_val)) + "%"
                            delta: "Action: " + root.detected_action_text
                        MetricCard:
                            title: "Audio Analysis"
                            icon: root.icons.MIC
                            value: str(int(root.audio_analysis_val)) + "%"
                            delta: root.audio_analysis_msg
                        MetricCard:
                            title: "Motion Impact"
                            icon: root.icons.PULSE
                            value: str(int(root.motion_impact_val)) + "%"
                            delta: "Gyro: " + root.gyro_status
                        MetricCard:
                            title: "Context Risk"
                            icon: root.icons.LOCATION
                            value: str(int(root.context_risk_val)) + "%"
                            delta: "Location Risk"

                    # System Confidence
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: 0.3
                        spacing: 8
                        padding: [5, 5]
                        
                        BoxLayout:
                            spacing: 8
                            Label:
                                text: "System Confidence"
                                font_size: '12sp'
                                color: (0.6, 0.6, 0.6, 1)
                                halign: 'left'
                                text_size: self.size
                            Label:
                                text: str(int(root.system_confidence * 100)) + "%"
                                font_size: '12sp'
                                bold: True
                                halign: 'right'
                                text_size: self.size
                        
                        Widget:
                            size_hint_y: None
                            height: '6dp'
                            canvas:
                                Color:
                                    rgba: (1, 1, 1, 0.1)
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [3]
                                Color:
                                    rgba: (0.1, 0.7, 0.9, 1)
                                RoundedRectangle:
                                    pos: self.pos
                                    size: (self.width * root.system_confidence, self.height)
                                    radius: [3]

                # --- CAMERA FEED (shown only in normal mode) ---
                BoxLayout:
                    size_hint_y: None
                    height: dp(280) if root.sos_manager.state == "IDLE" else 0
                    opacity: 1 if root.sos_manager.state == "IDLE" else 0
                    canvas.before:
                        Color:
                            rgba: (0, 0, 0, 1)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [20]
                        Color:
                            rgba: (1, 1, 1, 0.1)
                        Line:
                            rounded_rectangle: (self.x, self.y, self.width, self.height, 20)
                            width: 1.2
                    padding: 3
                    
                    CameraView:
                        id: camera_view

        # --- CONTROLS (Fixed at bottom) ---
        BoxLayout:
            size_hint_y: None
            height: '80dp'
            spacing: 12
            padding: [0, 8]
            
            Button:
                text: "START" if not app.is_monitoring else "STOP"
                font_size: '14sp'
                bold: True
                background_normal: ''
                background_color: (0, 0, 0, 0)
                color: (0.05, 0.8, 0.4, 1) if not app.is_monitoring else (1, 0.3, 0.3, 1)
                on_release: print("[KV DEBUG] START button clicked!") or root.toggle_monitoring()
                canvas.before:
                    Color:
                        rgba: (0.05, 0.8, 0.4, 0.2) if not app.is_monitoring else (0.8, 0.2, 0.2, 0.2)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [15]
                
            Button:
                text: "VOICE"
                font_size: '12sp'
                bold: True
                size_hint_x: 0.3
                background_normal: ''
                background_color: (0, 0, 0, 0)
                color: (0.1, 0.6, 1, 1) if root.voice_active else (0.6, 0.6, 0.6, 1)
                on_release: root.toggle_voice()
                canvas.before:
                    Color:
                        rgba: (0.1, 0.4, 0.8, 0.2) if root.voice_active else (0.2, 0.2, 0.2, 0.2)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [15]
                
            Button:
                text: "SOS"
                font_size: '16sp'
                bold: True
                size_hint_x: 0.5
                background_normal: ''
                background_color: (0, 0, 0, 0)
                color: (1, 1, 1, 1)
                on_release: root.manual_sos()
                canvas.before:
                    Color:
                        rgba: (0.9, 0.1, 0.1, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [15]

        # --- SOS CONTAINER (manages visibility) ---
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: 0 if root.sos_manager.state == "IDLE" else (dp(320) if root.sos_manager.state == "COUNTDOWN" else dp(420))
            padding: 0
            spacing: 0
            
            # COUNTDOWN PANEL
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: 1 if (root.sos_manager and root.sos_manager.state == "COUNTDOWN") else 0
                opacity: 1 if (root.sos_manager and root.sos_manager.state == "COUNTDOWN") else 0
                padding: 25
                spacing: 15
                canvas.before:
                    Color:
                        rgba: (0.85, 0.1, 0.1, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [25]
                    Color:
                        rgba: (1, 1, 1, 0.3)
                    Line:
                        rounded_rectangle: (self.x, self.y, self.width, self.height, 25)
                        width: 2.5
                
                BoxLayout:
                    size_hint_y: 0.25
                    spacing: 12
                    padding: [10, 0]
                    IconLabel:
                        text: root.icons.ALERT
                        font_size: '28sp'
                        color: (1, 1, 1, 1)
                        size_hint_x: None
                        width: self.height
                    Label:
                        text: "EMERGENCY ALERT"
                        font_size: '22sp'
                        bold: True
                        color: (1, 1, 1, 1)
                        halign: 'left'
                        text_size: self.size
                
                Label:
                    text: str(int(root.sos_manager.countdown_remaining)) if root.sos_manager else "3"
                    font_size: '120sp'
                    bold: True
                    color: (1, 1, 1, 1)
                    size_hint_y: 0.35
                
                Label:
                    text: "Broadcast initiates in"
                    font_size: '14sp'
                    color: (1, 1, 1, 0.8)
                    halign: 'center'
                    text_size: self.size
                    size_hint_y: 0.15

                BoxLayout:
                    size_hint_y: 0.25
                    spacing: 15
                    padding: [10, 0]
                    Button:
                        text: "CANCEL"
                        background_normal: ''
                        background_color: (0.2, 0.2, 0.2, 0.9)
                        bold: True
                        font_size: '14sp'
                        on_release: root.cancel_sos()
                        canvas.before:
                            Color:
                                rgba: self.background_color
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [12]
                    Button:
                        text: "SEND NOW"
                        background_normal: ''
                        background_color: (0.1, 0.7, 0.2, 1)
                        bold: True
                        font_size: '14sp'
                        on_release: root.send_sos_now()
                        canvas.before:
                            Color:
                                rgba: self.background_color
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [12]

            # BROADCAST PANEL
            ScrollView:
                size_hint_y: 1 if (root.sos_manager and root.sos_manager.state == "BROADCAST") else 0
                opacity: 1 if (root.sos_manager and root.sos_manager.state == "BROADCAST") else 0
                do_scroll_x: False
                do_scroll_y: True
                
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: 20
                    spacing: 15
                    canvas.before:
                        Color:
                            rgba: (0.08, 0.1, 0.15, 1)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [20]
                        Color:
                            rgba: (1, 0.2, 0.2, 0.9)
                        Line:
                            rounded_rectangle: (self.x, self.y, self.width, self.height, 20)
                            width: 2.5
                    
                    # HEADER
                    BoxLayout:
                        size_hint_y: None
                        height: '50dp'
                        spacing: 12
                        padding: [0, 5]
                        IconLabel:
                            text: root.icons.PULSE
                            color: (1, 0.2, 0.2, 1)
                            font_size: '24sp'
                            size_hint_x: None
                            width: self.height
                        Label:
                            text: "EMERGENCY BROADCAST ACTIVE"
                            color: (1, 0.3, 0.3, 1)
                            font_size: '18sp'
                            bold: True
                            halign: 'left'
                            text_size: self.size

                    # ALERT STATUS
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: '45dp'
                        padding: [12, 10]
                        spacing: 5
                        canvas.before:
                            Color:
                                rgba: (0.2, 0, 0, 0.8)
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [10]
                        Label:
                            text: "Status: BROADCASTING TO EMERGENCY SERVICES"
                            font_size: '12sp'
                            bold: True
                            color: (1, 0.2, 0.2, 1)
                            halign: 'center'
                            text_size: self.size
                        Label:
                            text: root.broadcast_contact
                            font_size: '11sp'
                            color: (0.8, 0.8, 0.8, 1)
                            halign: 'center'
                            text_size: self.size

                    # LOCATION
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: '65dp'
                        padding: [12, 10]
                        spacing: 8
                        canvas.before:
                            Color:
                                rgba: (0.12, 0.14, 0.18, 1)
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [10]
                        BoxLayout:
                            size_hint_y: 0.3
                            spacing: 10
                            IconLabel:
                                text: root.icons.LOCATION
                                font_size: '14sp'
                                color: (0.1, 0.7, 0.9, 1)
                                size_hint_x: None
                                width: self.height
                            Label:
                                text: "LOCATION"
                                font_size: '11sp'
                                color: (0.6, 0.6, 0.6, 1)
                                halign: 'left'
                                text_size: self.size
                        Label:
                            text: root.broadcast_location
                            font_size: '16sp'
                            bold: True
                            color: (1, 1, 1, 1)
                            halign: 'left'
                            text_size: self.size

                    # THREAT INFO
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: '80dp'
                        padding: [12, 10]
                        spacing: 8
                        canvas.before:
                            Color:
                                rgba: (0.12, 0.14, 0.18, 1)
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [10]
                        BoxLayout:
                            size_hint_y: 0.25
                            spacing: 10
                            IconLabel:
                                text: root.icons.ALERT
                                font_size: '14sp'
                                color: (1, 0.3, 0.3, 1)
                                size_hint_x: None
                                width: self.height
                            Label:
                                text: "THREAT"
                                font_size: '11sp'
                                color: (0.6, 0.6, 0.6, 1)
                                halign: 'left'
                                text_size: self.size
                        Label:
                            text: root.broadcast_threat
                            font_size: '14sp'
                            bold: True
                            color: (1, 1, 1, 1)
                            halign: 'left'
                            text_size: self.size

                    # ACTIVE TRIGGERS
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: '75dp'
                        padding: [12, 10]
                        spacing: 8
                        canvas.before:
                            Color:
                                rgba: (0.12, 0.14, 0.18, 1)
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [10]
                        BoxLayout:
                            size_hint_y: 0.25
                            spacing: 10
                            IconLabel:
                                text: root.icons.CHART
                                font_size: '14sp'
                                color: (0.1, 0.7, 0.9, 1)
                                size_hint_x: None
                                width: self.height
                            Label:
                                text: "DETECTED TRIGGERS"
                                font_size: '11sp'
                                color: (0.6, 0.6, 0.6, 1)
                                halign: 'left'
                                text_size: self.size
                        Label:
                            text: root.active_triggers
                            font_size: '13sp'
                            bold: True
                            color: (1, 1, 1, 1)
                            halign: 'left'
                            text_size: self.size

                    # CONFIDENCE
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: '50dp'
                        padding: [12, 10]
                        spacing: 6
                        canvas.before:
                            Color:
                                rgba: (0.12, 0.14, 0.18, 1)
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [10]
                        BoxLayout:
                            spacing: 8
                            Label:
                                text: "System Confidence"
                                font_size: '11sp'
                                color: (0.6, 0.6, 0.6, 1)
                                halign: 'left'
                                text_size: self.size
                            Label:
                                text: str(int(root.system_confidence * 100)) + "%"
                                font_size: '12sp'
                                bold: True
                                color: (0.1, 0.7, 0.9, 1)
                                halign: 'right'
                                text_size: self.size
                        Widget:
                            size_hint_y: None
                            height: '8dp'
                            canvas:
                                Color:
                                    rgba: (1, 1, 1, 0.15)
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [4]
                                Color:
                                    rgba: (0.1, 0.7, 0.9, 1)
                                RoundedRectangle:
                                    pos: self.pos
                                    size: (self.width * root.system_confidence, self.height)
                                    radius: [4]

                    # END BUTTON
                    Button:
                        text: "END EMERGENCY"
                        size_hint_y: None
                        height: '50dp'
                        background_normal: ''
                        background_color: (0.1, 0.6, 0.2, 1)
                        bold: True
                        font_size: '16sp'
                        on_release: root.end_emergency()
                        canvas.before:
                            Color:
                                rgba: self.background_color
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [12]
